# 🌌 智能论文阅读宇宙 - 配置示例
# 复制此文件为 agent-crawler/.env 并填入真实的API密钥

# ========================================
# LLM API Configuration (必需)
# ========================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Alternative LLM APIs (可选，二选一)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo

# ========================================
# Database Configuration (默认配置)
# ========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
QDRANT_URL=http://localhost:6333

# ========================================
# Processing Configuration (性能配置)
# ========================================
# 是否启用并发处理 (建议先设为false测试)
ENABLE_CONCURRENT_PROCESSING=false
# 并发工作线程数
MAX_CONCURRENT_WORKERS=3

# ========================================
# Daily Scheduler Configuration (每日调度)
# ========================================
# 每日抓取论文数量
DAILY_PAPER_COUNT=10
# 是否启用智能模式 (递归抓取重要引用)
DAILY_SMART_MODE=true
# 每日执行时间 (24小时制)
DAILY_SCHEDULE_TIME=10:00

# ========================================
# Optional: Advanced Settings (高级配置)
# ========================================
# 自定义文本嵌入模型
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 自定义图像嵌入模型  
# IMAGE_MODEL=openai/clip-vit-base-patch32

# ========================================
# Development Settings (开发配置)
# ========================================
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# Usage Instructions (使用说明)
# ========================================
# 1. 复制此文件: cp config.example.env agent-crawler/.env
# 2. 编辑 agent-crawler/.env 文件
# 3. 必须填入有效的 GROQ_API_KEY
# 4. 其他配置可保持默认值
# 5. 首次使用建议关闭并发处理进行测试
